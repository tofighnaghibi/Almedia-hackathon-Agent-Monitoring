  {
   "id": "f0_e943528",
   "type": "text",
   "x": 2318,
   "y": 130.625,
   "width": 404,
   "height": 168.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
