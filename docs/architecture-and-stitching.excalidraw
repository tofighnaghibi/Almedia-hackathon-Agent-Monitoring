   "version": 1,
   "versionNonce": 332800430,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Rule: a dataset stays only where it works (\u2714) or works partly on something real (\u25d0). Nothing failing, missing or downloading remains. Verdict: USABLE = primary passes; USABLE* = primary partial, secondary passes; CAVEATS = only partial evidence; ASSUMED = no data.",
   "originalText": "Rule: a dataset stays only where it works (\u2714) or works partly on something real (\u25d0). Nothing failing, missing or downloading remains. Verdict: USABLE = primary passes; USABLE* = primary partial, secondary passes; CAVEATS = only partial evidence; ASSUMED = no data.",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
