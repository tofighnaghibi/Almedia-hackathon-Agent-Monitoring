   "updated": 1,
   "link": null,
   "locked": false,
   "text": "D1  Strategy: Olist-anchored + data stitching  \u2714",
   "originalText": "D1  Strategy: Olist-anchored + data stitching  \u2714",
   "fontSize": 22,
   "fontFamily": 1,
