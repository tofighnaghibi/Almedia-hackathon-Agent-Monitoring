  {
   "id": "e441365",
   "type": "text",
   "x": 1878,
   "y": 130.625,
   "width": 404,
   "height": 168.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
