   "version": 1,
   "versionNonce": 625380077,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Logs where actions were chosen at random with known probabilities (Open Bandit, Criteo). Off-\npolicy evaluation (OPE) uses them to estimate another policy's value, valid only for the logged\npopulation, support and assumptions: a real reference, not universal ground truth.",
   "originalText": "Logs where actions were chosen at random with known probabilities (Open Bandit, Criteo). Off-\npolicy evaluation (OPE) uses them to estimate another policy's value, valid only for the logged\npopulation, support and assumptions: a real reference, not universal ground truth.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
