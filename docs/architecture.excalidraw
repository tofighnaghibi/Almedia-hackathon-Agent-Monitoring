   "seed": 1709832945,
   "version": 1,
   "versionNonce": 403811335,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Olist-anchored  (recommended)\n\n+ real chain: on-time 4.29\u2605 \u2192 >10 d late 1.71\u2605\n+ real shocks: Black Friday 6.2\u00d7, 2018 strike\n   (promise 20 \u2192 37 d, late rate fell to 0.4%)\n+ 12.8% of items in multi-seller products\n\u2212 small: 99,441 orders, 3,095 sellers, 2017\u201318\n\u2212 96.9% one-time buyers; clicks, ads synthetic\n\u2212 Brazil; transfer from other markets assumed",
   "originalText": "Olist-anchored  (recommended)\n\n+ real chain: on-time 4.29\u2605 \u2192 >10 d late 1.71\u2605\n+ real shocks: Black Friday 6.2\u00d7, 2018 strike\n   (promise 20 \u2192 37 d, late rate fell to 0.4%)\n+ 12.8% of items in multi-seller products\n\u2212 small: 99,441 orders, 3,095 sellers, 2017\u201318\n\u2212 96.9% one-time buyers; clicks, ads synthetic\n\u2212 Brazil; transfer from other markets assumed",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "e327160",
   "lineHeight": 1.25,
   "autoResize": true
  },
