   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Amazon-centred\n\n+ huge catalog, real review dynamics\n+ ESCI \u2229 Reviews (US): 447,879 products\n   = 36.8% of ESCI-US  (measured)\n\u2212 M2 has no US; only 2\u20137% of M2 IDs in Reviews\n\u2212 no shared buyers, sellers, orders,\n   fulfilment: whole operational half invented\n\u2212 es / jp IDs match only 7.3% / 3.2%",
   "originalText": "Amazon-centred\n\n+ huge catalog, real review dynamics\n+ ESCI \u2229 Reviews (US): 447,879 products\n   = 36.8% of ESCI-US  (measured)\n\u2212 M2 has no US; only 2\u20137% of M2 IDs in Reviews\n\u2212 no shared buyers, sellers, orders,\n   fulfilment: whole operational half invented\n\u2212 es / jp IDs match only 7.3% / 3.2%",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "e270973",
   "lineHeight": 1.25,
   "autoResize": true
  },
