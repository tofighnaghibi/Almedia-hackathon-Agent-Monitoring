   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The world advances in 1-hour ticks; delayed events (deliveries, reviews, restocks) wait in a\nqueue until their time. Simple and fast while keeping exact timestamps.",
   "originalText": "The world advances in 1-hour ticks; delayed events (deliveries, reviews, restocks) wait in a\nqueue until their time. Simple and fast while keeping exact timestamps.",
