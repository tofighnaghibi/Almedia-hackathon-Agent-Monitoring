# Same line endings on Windows and Mac: store and check out text files with LF.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never touch
*.png binary
*.jpg binary
*.parquet binary
*.duckdb binary
*.db binary
*.zip binary
