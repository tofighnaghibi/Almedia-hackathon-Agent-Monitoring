# Copy this file to .env and fill in your values. .env is git-ignored: never commit keys.
# The demo and the scripts read .env on start; a variable already set in your shell wins.

# Required for the model (without these the system runs on the rule-based fallback)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Optional
LLM_REPORT_MODEL=            # model that writes report text (default: LLM_MODEL)
LLM_CACHE_MODE=live          # live | record | replay  (replay needs no key and no network)
LLM_CACHE_DIR=data/llm_cache
LLM_TIMEOUT=30               # seconds per request
LLM_MAX_TOKENS=1024          # reply budget per call
LLM_EFFORT=low               # low | medium | high | none
