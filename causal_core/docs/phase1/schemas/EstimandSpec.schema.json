{
  "$defs": {
    "EnvironmentScope": {
      "additionalProperties": false,
      "properties": {
        "data_cut": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Cut"
        },
        "dataset_version": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Version"
        },
        "environment_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
          "title": "Environment Id",
          "type": "string"
        },
        "environment_kind": {
          "enum": [
            "production",
            "staging",
            "emulator",
            "offline_replay",
            "legacy_unscoped"
          ],
          "title": "Environment Kind",
          "type": "string"
        },
        "generator_version": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generator Version"
        }
      },
      "required": [
        "environment_id",
        "environment_kind"
      ],
      "title": "EnvironmentScope",
      "type": "object"
    },
    "InterventionContrast": {
      "additionalProperties": false,
      "properties": {
        "control": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Control",
          "type": "string"
        },
        "treatment": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Treatment",
          "type": "string"
        }
      },
      "required": [
        "treatment",
        "control"
      ],
      "title": "InterventionContrast",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Exactly what effect is asked for. No 'lift' with an undefined treatment, time or population.\n\nBoth scopes are required (v3.2 \u00a72.1, I05; CP-004): where the evidence comes from and where the\neffect is claimed to hold. If they differ, transport must be argued explicitly (\u00a74.5 item 5).",
  "properties": {
    "contrast": {
      "$ref": "#/$defs/InterventionContrast"
    },
    "functional": {
      "enum": [
        "ATE",
        "ATT",
        "ITT",
        "CACE",
        "risk_difference",
        "mean_difference",
        "dose_response",
        "policy_value"
      ],
      "title": "Functional",
      "type": "string"
    },
    "horizon": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Horizon",
      "type": "string"
    },
    "outcome": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
      "title": "Outcome",
      "type": "string"
    },
    "population": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Population",
      "type": "string"
    },
    "source_scope": {
      "$ref": "#/$defs/EnvironmentScope"
    },
    "target_scope": {
      "$ref": "#/$defs/EnvironmentScope"
    }
  },
  "required": [
    "outcome",
    "contrast",
    "population",
    "horizon",
    "functional",
    "source_scope",
    "target_scope"
  ],
  "title": "EstimandSpec",
  "type": "object"
}
