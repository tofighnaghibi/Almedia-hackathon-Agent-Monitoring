{
  "$defs": {
    "EnvironmentScope": {
      "additionalProperties": false,
      "properties": {
        "data_cut": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Cut"
        },
        "dataset_version": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Version"
        },
        "environment_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
          "title": "Environment Id",
          "type": "string"
        },
        "environment_kind": {
          "enum": [
            "production",
            "staging",
            "emulator",
            "offline_replay",
            "legacy_unscoped"
          ],
          "title": "Environment Kind",
          "type": "string"
        },
        "generator_version": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generator Version"
        }
      },
      "required": [
        "environment_id",
        "environment_kind"
      ],
      "title": "EnvironmentScope",
      "type": "object"
    },
    "LagBounds": {
      "additionalProperties": false,
      "properties": {
        "max_s": {
          "minimum": 0,
          "title": "Max S",
          "type": "number"
        },
        "min_s": {
          "minimum": 0,
          "title": "Min S",
          "type": "number"
        }
      },
      "required": [
        "min_s",
        "max_s"
      ],
      "title": "LagBounds",
      "type": "object"
    },
    "ProvenanceLineage": {
      "additionalProperties": false,
      "description": "Ancestry, not independence: distinct roots do not imply independent evidence (I10).",
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "generator_version": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generator Version"
        },
        "lineage_root_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
          "title": "Lineage Root Id",
          "type": "string"
        },
        "origin_kind": {
          "enum": [
            "original",
            "synthetic_generated",
            "synthetic_replica",
            "model_prediction",
            "external_study",
            "legacy_unknown"
          ],
          "title": "Origin Kind",
          "type": "string"
        },
        "parent_evidence_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
            "type": "string"
          },
          "title": "Parent Evidence Ids",
          "type": "array"
        },
        "source_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
          "title": "Source Id",
          "type": "string"
        },
        "transformation_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transformation Hash"
        }
      },
      "required": [
        "source_id",
        "origin_kind",
        "lineage_root_id",
        "content_hash"
      ],
      "title": "ProvenanceLineage",
      "type": "object"
    },
    "Validity": {
      "additionalProperties": false,
      "properties": {
        "valid_from": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        }
      },
      "title": "Validity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "edge_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
      "title": "Edge Id",
      "type": "string"
    },
    "entity_match_confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Entity Match Confidence"
    },
    "identification_ref": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Identification Ref"
    },
    "kind": {
      "enum": [
        "EXACT_ARITHMETIC",
        "AGGREGATION_COMPOSITION",
        "DIMENSIONAL_DECOMPOSITION",
        "ENTITY_RELATIONSHIP",
        "TEMPORAL_WINDOW",
        "TEMPORAL_LAG",
        "TEMPORAL_FEEDBACK",
        "OBSERVATION_EFFECT",
        "OBSERVATIONAL_ASSOCIATION",
        "CAUSAL_HYPOTHESIS",
        "CAUSALLY_IDENTIFIED",
        "LATENT_CONFOUNDING",
        "UNKNOWN_RELATIONSHIP"
      ],
      "title": "Kind",
      "type": "string"
    },
    "lag": {
      "anyOf": [
        {
          "$ref": "#/$defs/LagBounds"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "layer": {
      "default": "DOMAIN",
      "enum": [
        "DOMAIN",
        "OBSERVATION"
      ],
      "title": "Layer",
      "type": "string"
    },
    "lineage": {
      "$ref": "#/$defs/ProvenanceLineage"
    },
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/EnvironmentScope"
    },
    "source": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
      "title": "Source",
      "type": "string"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "QUARANTINED",
        "SUPERSEDED",
        "REFUTED",
        "REVIEW_REQUIRED"
      ],
      "title": "Status",
      "type": "string"
    },
    "status_reasons": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Status Reasons",
      "type": "array"
    },
    "target": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
      "title": "Target",
      "type": "string"
    },
    "validity": {
      "$ref": "#/$defs/Validity",
      "default": {
        "valid_from": null,
        "valid_to": null
      }
    }
  },
  "required": [
    "schema_version",
    "edge_id",
    "kind",
    "source",
    "target",
    "status",
    "lineage",
    "scope"
  ],
  "title": "GraphEdge",
  "type": "object"
}
