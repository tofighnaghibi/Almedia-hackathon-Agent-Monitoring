{
  "$defs": {
    "AggregateStats": {
      "additionalProperties": false,
      "properties": {
        "covariance_ref": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Covariance Ref"
        },
        "denominator": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "iid": {
          "default": "UNKNOWN",
          "enum": [
            "UNKNOWN",
            "ASSERTED_BY_SOURCE",
            "NOT_IID"
          ],
          "title": "Iid",
          "type": "string"
        },
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "numerator": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator"
        },
        "se": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Se"
        },
        "shape": {
          "const": "aggregate_stats",
          "title": "Shape",
          "type": "string"
        },
        "sum_sq": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sum Sq"
        },
        "total": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total"
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeWindow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "shape",
        "n"
      ],
      "title": "AggregateStats",
      "type": "object"
    },
    "AssignedUnit": {
      "additionalProperties": false,
      "properties": {
        "arm": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
          "title": "Arm",
          "type": "string"
        },
        "cluster_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cluster Id"
        },
        "exposure": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exposure"
        },
        "outcome": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "unit_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
          "title": "Unit Id",
          "type": "string"
        }
      },
      "required": [
        "unit_id",
        "arm"
      ],
      "title": "AssignedUnit",
      "type": "object"
    },
    "AssignmentOutcomes": {
      "additionalProperties": false,
      "properties": {
        "arms": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
            "type": "string"
          },
          "minItems": 2,
          "title": "Arms",
          "type": "array"
        },
        "shape": {
          "const": "assignment_outcomes",
          "title": "Shape",
          "type": "string"
        },
        "study_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
          "title": "Study Id",
          "type": "string"
        },
        "units": {
          "items": {
            "$ref": "#/$defs/AssignedUnit"
          },
          "minItems": 1,
          "title": "Units",
          "type": "array"
        }
      },
      "required": [
        "shape",
        "study_id",
        "arms",
        "units"
      ],
      "title": "AssignmentOutcomes",
      "type": "object"
    },
    "CategoricalValue": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Category",
          "type": "string"
        },
        "shape": {
          "const": "categorical",
          "title": "Shape",
          "type": "string"
        }
      },
      "required": [
        "shape",
        "category"
      ],
      "title": "CategoricalValue",
      "type": "object"
    },
    "Clock": {
      "additionalProperties": false,
      "description": "A timestamp with an honest quality label. UNKNOWN never carries a value.",
      "properties": {
        "quality": {
          "enum": [
            "KNOWN",
            "ESTIMATED",
            "UNKNOWN"
          ],
          "title": "Quality",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "quality"
      ],
      "title": "Clock",
      "type": "object"
    },
    "DataQuality": {
      "additionalProperties": false,
      "properties": {
        "completeness": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completeness"
        },
        "maturity": {
          "default": "UNKNOWN",
          "enum": [
            "MATURE",
            "IMMATURE",
            "UNKNOWN"
          ],
          "title": "Maturity",
          "type": "string"
        },
        "missingness": {
          "default": "unknown",
          "enum": [
            "none_declared",
            "declared",
            "unknown"
          ],
          "title": "Missingness",
          "type": "string"
        },
        "selection": {
          "default": "unknown",
          "enum": [
            "none_declared",
            "declared",
            "unknown"
          ],
          "title": "Selection",
          "type": "string"
        }
      },
      "title": "DataQuality",
      "type": "object"
    },
    "EnvironmentScope": {
      "additionalProperties": false,
      "properties": {
        "data_cut": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Cut"
        },
        "dataset_version": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Version"
        },
        "environment_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
          "title": "Environment Id",
          "type": "string"
        },
        "environment_kind": {
          "enum": [
            "production",
            "staging",
            "emulator",
            "offline_replay",
            "legacy_unscoped"
          ],
          "title": "Environment Kind",
          "type": "string"
        },
        "generator_version": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generator Version"
        }
      },
      "required": [
        "environment_id",
        "environment_kind"
      ],
      "title": "EnvironmentScope",
      "type": "object"
    },
    "EventBatch": {
      "additionalProperties": false,
      "properties": {
        "events": {
          "items": {
            "$ref": "#/$defs/EventRecord"
          },
          "minItems": 1,
          "title": "Events",
          "type": "array"
        },
        "shape": {
          "const": "event_batch",
          "title": "Shape",
          "type": "string"
        }
      },
      "required": [
        "shape",
        "events"
      ],
      "title": "EventBatch",
      "type": "object"
    },
    "EventRecord": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "default": {},
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "propertyNames": {
            "maxLength": 200,
            "minLength": 1
          },
          "title": "Attributes",
          "type": "object"
        },
        "event_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
          "title": "Event Id",
          "type": "string"
        },
        "occurred_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Clock"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "event_id"
      ],
      "title": "EventRecord",
      "type": "object"
    },
    "FormulaBinOp": {
      "additionalProperties": false,
      "properties": {
        "left": {
          "discriminator": {
            "mapping": {
              "binop": "#/$defs/FormulaBinOp",
              "const": "#/$defs/FormulaConst",
              "ref": "#/$defs/FormulaRef"
            },
            "propertyName": "node"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FormulaRef"
            },
            {
              "$ref": "#/$defs/FormulaConst"
            },
            {
              "$ref": "#/$defs/FormulaBinOp"
            }
          ],
          "title": "Left"
        },
        "node": {
          "const": "binop",
          "title": "Node",
          "type": "string"
        },
        "op": {
          "enum": [
            "add",
            "sub",
            "mul",
            "div"
          ],
          "title": "Op",
          "type": "string"
        },
        "right": {
          "discriminator": {
            "mapping": {
              "binop": "#/$defs/FormulaBinOp",
              "const": "#/$defs/FormulaConst",
              "ref": "#/$defs/FormulaRef"
            },
            "propertyName": "node"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FormulaRef"
            },
            {
              "$ref": "#/$defs/FormulaConst"
            },
            {
              "$ref": "#/$defs/FormulaBinOp"
            }
          ],
          "title": "Right"
        }
      },
      "required": [
        "node",
        "op",
        "left",
        "right"
      ],
      "title": "FormulaBinOp",
      "type": "object"
    },
    "FormulaConst": {
      "additionalProperties": false,
      "properties": {
        "node": {
          "const": "const",
          "title": "Node",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "node",
        "value"
      ],
      "title": "FormulaConst",
      "type": "object"
    },
    "FormulaRef": {
      "additionalProperties": false,
      "properties": {
        "node": {
          "const": "ref",
          "title": "Node",
          "type": "string"
        },
        "variable_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
          "title": "Variable Id",
          "type": "string"
        }
      },
      "required": [
        "node",
        "variable_id"
      ],
      "title": "FormulaRef",
      "type": "object"
    },
    "GraphEdge": {
      "additionalProperties": false,
      "properties": {
        "edge_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
          "title": "Edge Id",
          "type": "string"
        },
        "entity_match_confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Match Confidence"
        },
        "identification_ref": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identification Ref"
        },
        "kind": {
          "enum": [
            "EXACT_ARITHMETIC",
            "AGGREGATION_COMPOSITION",
            "DIMENSIONAL_DECOMPOSITION",
            "ENTITY_RELATIONSHIP",
            "TEMPORAL_WINDOW",
            "TEMPORAL_LAG",
            "TEMPORAL_FEEDBACK",
            "OBSERVATION_EFFECT",
            "OBSERVATIONAL_ASSOCIATION",
            "CAUSAL_HYPOTHESIS",
            "CAUSALLY_IDENTIFIED",
            "LATENT_CONFOUNDING",
            "UNKNOWN_RELATIONSHIP"
          ],
          "title": "Kind",
          "type": "string"
        },
        "lag": {
          "anyOf": [
            {
              "$ref": "#/$defs/LagBounds"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "layer": {
          "default": "DOMAIN",
          "enum": [
            "DOMAIN",
            "OBSERVATION"
          ],
          "title": "Layer",
          "type": "string"
        },
        "lineage": {
          "$ref": "#/$defs/ProvenanceLineage"
        },
        "schema_version": {
          "const": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/EnvironmentScope"
        },
        "source": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
          "title": "Source",
          "type": "string"
        },
        "status": {
          "enum": [
            "ACTIVE",
            "QUARANTINED",
            "SUPERSEDED",
            "REFUTED",
            "REVIEW_REQUIRED"
          ],
          "title": "Status",
          "type": "string"
        },
        "status_reasons": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Status Reasons",
          "type": "array"
        },
        "target": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
          "title": "Target",
          "type": "string"
        },
        "validity": {
          "$ref": "#/$defs/Validity",
          "default": {
            "valid_from": null,
            "valid_to": null
          }
        }
      },
      "required": [
        "schema_version",
        "edge_id",
        "kind",
        "source",
        "target",
        "status",
        "lineage",
        "scope"
      ],
      "title": "GraphEdge",
      "type": "object"
    },
    "LagBounds": {
      "additionalProperties": false,
      "properties": {
        "max_s": {
          "minimum": 0,
          "title": "Max S",
          "type": "number"
        },
        "min_s": {
          "minimum": 0,
          "title": "Min S",
          "type": "number"
        }
      },
      "required": [
        "min_s",
        "max_s"
      ],
      "title": "LagBounds",
      "type": "object"
    },
    "MetricDefinition": {
      "additionalProperties": false,
      "properties": {
        "aggregation_kind": {
          "anyOf": [
            {
              "enum": [
                "sum",
                "count",
                "mean",
                "ratio",
                "quantile",
                "min",
                "max"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aggregation Kind"
        },
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "entity_ref": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Ref"
        },
        "extensions": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "default": {},
          "title": "Extensions",
          "type": "object"
        },
        "formula_ast": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "binop": "#/$defs/FormulaBinOp",
                  "const": "#/$defs/FormulaConst",
                  "ref": "#/$defs/FormulaRef"
                },
                "propertyName": "node"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/FormulaRef"
                },
                {
                  "$ref": "#/$defs/FormulaConst"
                },
                {
                  "$ref": "#/$defs/FormulaBinOp"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Formula Ast"
        },
        "identity_tolerance": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identity Tolerance"
        },
        "kind": {
          "const": "metric",
          "title": "Kind",
          "type": "string"
        },
        "population_coverage": {
          "anyOf": [
            {
              "$ref": "#/$defs/PopulationCoverage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provenance": {
          "$ref": "#/$defs/SourceAttestation"
        },
        "schema_version": {
          "const": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/EnvironmentScope"
        },
        "time_semantics": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetricTimeSemantics"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unit": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value_schema": {
          "$ref": "#/$defs/NumericValueSchema"
        },
        "variable_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
          "title": "Variable Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "variable_id",
        "scope",
        "provenance",
        "kind",
        "value_schema"
      ],
      "title": "MetricDefinition",
      "type": "object"
    },
    "MetricTimeSemantics": {
      "additionalProperties": false,
      "properties": {
        "grain": {
          "pattern": "^[1-9][0-9]*(m|h|d|w)$",
          "title": "Grain",
          "type": "string"
        },
        "timezone": {
          "default": "UTC",
          "minLength": 1,
          "pattern": "\\S",
          "title": "Timezone",
          "type": "string"
        },
        "window": {
          "default": "unknown",
          "enum": [
            "tumbling",
            "rolling",
            "cumulative",
            "unknown"
          ],
          "title": "Window",
          "type": "string"
        }
      },
      "required": [
        "grain"
      ],
      "title": "MetricTimeSemantics",
      "type": "object"
    },
    "MigrationReceipt": {
      "additionalProperties": false,
      "properties": {
        "migrated_at": {
          "format": "date-time",
          "title": "Migrated At",
          "type": "string"
        },
        "migrator_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Migrator Version",
          "type": "string"
        },
        "original_bytes": {
          "minimum": 0,
          "title": "Original Bytes",
          "type": "integer"
        },
        "original_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Original Sha256",
          "type": "string"
        },
        "source_kind": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Kind"
        },
        "source_schema_version": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Schema Version"
        },
        "target_schema_version": {
