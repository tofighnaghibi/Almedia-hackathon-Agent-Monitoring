{
  "$defs": {
    "EdgeOutcome": {
      "additionalProperties": false,
      "properties": {
        "edge_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
          "title": "Edge Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Kind",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "ADMITTED",
            "QUARANTINED",
            "REJECTED"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reasons": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "ACTIVE",
                "QUARANTINED",
                "SUPERSEDED",
                "REFUTED",
                "REVIEW_REQUIRED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        }
      },
      "required": [
        "edge_id",
        "kind",
        "outcome"
      ],
      "title": "EdgeOutcome",
      "type": "object"
    },
    "StepResult": {
      "additionalProperties": false,
      "properties": {
        "details": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Details",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "NOT_APPLICABLE",
            "QUARANTINE",
            "REJECT",
            "SKIPPED"
          ],
          "title": "Status",
          "type": "string"
        },
        "step": {
          "maximum": 8,
          "minimum": 1,
          "title": "Step",
          "type": "integer"
        }
      },
      "required": [
        "step",
        "name",
        "status"
      ],
      "title": "StepResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "downstream_reverify": {
      "default": [],
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
        "type": "string"
      },
      "title": "Downstream Reverify",
      "type": "array"
    },
    "edges": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EdgeOutcome"
      },
      "title": "Edges",
      "type": "array"
    },
    "graph_version": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Graph Version"
    },
    "notified_subscribers": {
      "default": [],
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
        "type": "string"
      },
      "title": "Notified Subscribers",
      "type": "array"
    },
    "outcome": {
      "enum": [
        "COMMITTED",
        "IDEMPOTENT_NOOP",
        "REJECTED"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "request_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/StepResult"
      },
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "outcome",
    "steps"
  ],
  "title": "AdmissionVerdict",
  "type": "object"
}
