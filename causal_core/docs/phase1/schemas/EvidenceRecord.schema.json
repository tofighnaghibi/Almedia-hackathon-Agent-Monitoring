{
  "$defs": {
    "EnvironmentScope": {
      "additionalProperties": false,
      "properties": {
        "data_cut": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Cut"
        },
        "dataset_version": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Version"
        },
        "environment_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
          "title": "Environment Id",
          "type": "string"
        },
        "environment_kind": {
          "enum": [
            "production",
            "staging",
            "emulator",
            "offline_replay",
            "legacy_unscoped"
          ],
          "title": "Environment Kind",
          "type": "string"
        },
        "generator_version": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generator Version"
        }
      },
      "required": [
        "environment_id",
        "environment_kind"
      ],
      "title": "EnvironmentScope",
      "type": "object"
    },
    "MethodProvenance": {
      "additionalProperties": false,
      "properties": {
        "method_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
          "title": "Method Id",
          "type": "string"
        },
        "method_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Method Version",
          "type": "string"
        },
        "parameters_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameters Hash"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "required": [
        "method_id",
        "method_version"
      ],
      "title": "MethodProvenance",
      "type": "object"
    },
    "ProvenanceLineage": {
      "additionalProperties": false,
      "description": "Ancestry, not independence: distinct roots do not imply independent evidence (I10).",
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "generator_version": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generator Version"
        },
        "lineage_root_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
          "title": "Lineage Root Id",
          "type": "string"
        },
        "origin_kind": {
          "enum": [
            "original",
            "synthetic_generated",
            "synthetic_replica",
            "model_prediction",
            "external_study",
            "legacy_unknown"
          ],
          "title": "Origin Kind",
          "type": "string"
        },
        "parent_evidence_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
            "type": "string"
          },
          "title": "Parent Evidence Ids",
          "type": "array"
        },
        "source_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
          "title": "Source Id",
          "type": "string"
        },
        "transformation_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transformation Hash"
        }
      },
      "required": [
        "source_id",
        "origin_kind",
        "lineage_root_id",
        "content_hash"
      ],
      "title": "ProvenanceLineage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "evidence_class": {
      "anyOf": [
        {
          "enum": [
            "OBSERVED",
            "EXPERIMENTAL",
            "EMULATOR_OBSERVATION",
            "MODEL_PREDICTION"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Class"
    },
    "evidence_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
      "title": "Evidence Id",
      "type": "string"
    },
    "lineage": {
      "$ref": "#/$defs/ProvenanceLineage"
    },
    "method": {
      "anyOf": [
        {
          "$ref": "#/$defs/MethodProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provenance_role": {
      "enum": [
        "REAL_OBSERVED",
        "EXTERNAL_STUDY",
        "SANDBOX_OBSERVED",
        "SYNTHETIC_GENERATED",
        "SYNTHETIC_REPLICA",
        "MODEL_PREDICTION",
        "LEGACY_UNSCOPED"
      ],
      "title": "Provenance Role",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/EnvironmentScope"
    }
  },
  "required": [
    "schema_version",
    "evidence_id",
    "lineage",
    "scope",
    "provenance_role",
    "content_hash"
  ],
  "title": "EvidenceRecord",
  "type": "object"
}
