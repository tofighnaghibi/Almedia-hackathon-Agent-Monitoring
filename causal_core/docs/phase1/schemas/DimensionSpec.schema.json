{
  "$defs": {
    "EnvironmentScope": {
      "additionalProperties": false,
      "properties": {
        "data_cut": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Cut"
        },
        "dataset_version": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Version"
        },
        "environment_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
          "title": "Environment Id",
          "type": "string"
        },
        "environment_kind": {
          "enum": [
            "production",
            "staging",
            "emulator",
            "offline_replay",
            "legacy_unscoped"
          ],
          "title": "Environment Kind",
          "type": "string"
        },
        "generator_version": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generator Version"
        }
      },
      "required": [
        "environment_id",
        "environment_kind"
      ],
      "title": "EnvironmentScope",
      "type": "object"
    },
    "SourceAttestation": {
      "additionalProperties": false,
      "description": "Who vouches for a record. A string label is not trust; 'signed' needs a signature.",
      "properties": {
        "attested_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attested At"
        },
        "method": {
          "enum": [
            "adapter_declared",
            "signed",
            "none"
          ],
          "title": "Method",
          "type": "string"
        },
        "signature": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signature"
        },
        "source_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "method"
      ],
      "title": "SourceAttestation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A partition key. Completeness is declared, never assumed; OTHER exists only if declared.",
  "properties": {
    "cardinality_hint": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cardinality Hint"
    },
    "dimension_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
      "title": "Dimension Id",
      "type": "string"
    },
    "entity_type_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Entity Type Id"
    },
    "missing_code": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Missing Code"
    },
    "other_code": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Other Code"
    },
    "partition_policy": {
      "enum": [
        "exhaustive_declared",
        "top_k_plus_other",
        "open_unknown"
      ],
      "title": "Partition Policy",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/SourceAttestation"
    },
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/EnvironmentScope"
    },
    "top_k": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Top K"
    },
    "values": {
      "anyOf": [
        {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Values"
    }
  },
  "required": [
    "schema_version",
    "dimension_id",
    "scope",
    "provenance",
    "partition_policy"
  ],
  "title": "DimensionSpec",
  "type": "object"
}
