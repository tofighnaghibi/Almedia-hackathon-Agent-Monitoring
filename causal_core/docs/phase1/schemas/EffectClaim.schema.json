{
  "$defs": {
    "EnvironmentScope": {
      "additionalProperties": false,
      "properties": {
        "data_cut": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Cut"
        },
        "dataset_version": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Version"
        },
        "environment_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
          "title": "Environment Id",
          "type": "string"
        },
        "environment_kind": {
          "enum": [
            "production",
            "staging",
            "emulator",
            "offline_replay",
            "legacy_unscoped"
          ],
          "title": "Environment Kind",
          "type": "string"
        },
        "generator_version": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generator Version"
        }
      },
      "required": [
        "environment_id",
        "environment_kind"
      ],
      "title": "EnvironmentScope",
      "type": "object"
    },
    "EstimandSpec": {
      "additionalProperties": false,
      "description": "Exactly what effect is asked for. No 'lift' with an undefined treatment, time or population.\n\nBoth scopes are required (v3.2 \u00a72.1, I05; CP-004): where the evidence comes from and where the\neffect is claimed to hold. If they differ, transport must be argued explicitly (\u00a74.5 item 5).",
      "properties": {
        "contrast": {
          "$ref": "#/$defs/InterventionContrast"
        },
        "functional": {
          "enum": [
            "ATE",
            "ATT",
            "ITT",
            "CACE",
            "risk_difference",
            "mean_difference",
            "dose_response",
            "policy_value"
          ],
          "title": "Functional",
          "type": "string"
        },
        "horizon": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Horizon",
          "type": "string"
        },
        "outcome": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
          "title": "Outcome",
          "type": "string"
        },
        "population": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Population",
          "type": "string"
        },
        "source_scope": {
          "$ref": "#/$defs/EnvironmentScope"
        },
        "target_scope": {
          "$ref": "#/$defs/EnvironmentScope"
        }
      },
      "required": [
        "outcome",
        "contrast",
        "population",
        "horizon",
        "functional",
        "source_scope",
        "target_scope"
      ],
      "title": "EstimandSpec",
      "type": "object"
    },
    "InterventionContrast": {
      "additionalProperties": false,
      "properties": {
        "control": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Control",
          "type": "string"
        },
        "treatment": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Treatment",
          "type": "string"
        }
      },
      "required": [
        "treatment",
        "control"
      ],
      "title": "InterventionContrast",
      "type": "object"
    },
    "MethodProvenance": {
      "additionalProperties": false,
      "properties": {
        "method_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
          "title": "Method Id",
          "type": "string"
        },
        "method_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Method Version",
          "type": "string"
        },
        "parameters_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameters Hash"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "required": [
        "method_id",
        "method_version"
      ],
      "title": "MethodProvenance",
      "type": "object"
    },
    "Uncertainty": {
      "additionalProperties": false,
      "properties": {
        "interval": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval"
        },
        "level": {
          "default": 0.95,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Level",
          "type": "number"
        },
        "se": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Se"
        }
      },
      "title": "Uncertainty",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A scoped, conditional effect on a declared estimand. Never a structural edge by itself (I06).",
  "properties": {
    "assessment_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
      "title": "Assessment Id",
      "type": "string"
    },
    "assessment_status": {
      "enum": [
        "CONDITIONAL_IDENTIFICATION",
        "PARTIAL_IDENTIFICATION",
        "ASSOCIATION_ONLY",
        "UNIDENTIFIED",
        "INVALID_DESIGN",
        "INSUFFICIENT_EVIDENCE"
      ],
      "title": "Assessment Status",
      "type": "string"
    },
    "claim_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
      "title": "Claim Id",
      "type": "string"
    },
    "dependence_model": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Dependence Model",
      "type": "string"
    },
    "estimand": {
      "$ref": "#/$defs/EstimandSpec"
    },
    "estimate": {
      "title": "Estimate",
      "type": "number"
    },
    "evidence_ids": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    },
    "method": {
      "$ref": "#/$defs/MethodProvenance"
    },
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/EnvironmentScope"
    },
    "uncertainty": {
      "$ref": "#/$defs/Uncertainty"
    }
  },
  "required": [
    "schema_version",
    "claim_id",
    "estimand",
    "assessment_id",
    "assessment_status",
    "estimate",
    "uncertainty",
    "dependence_model",
    "scope",
    "evidence_ids",
    "method"
  ],
  "title": "EffectClaim",
  "type": "object"
}
